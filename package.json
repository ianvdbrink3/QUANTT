{
  "name": "quantt-research",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify:research": "node scripts/reproduce-research",
    "verify:holdout": "node scripts/verify-holdout",
    "verify:continuous": "node scripts/verify-continuous",
    "research:volume-path": "node scripts/research-volume-path",
    "research:volume-stability": "node scripts/research-volume-stability",
    "verify:freeze": "python3 scripts/verify_research_freeze.py",
    "verify:oos-year": "node scripts/verify-oos-year",
    "verify:oos-year-parity": "node scripts/verify-oos-year --historical-parity",
    "prepare:oos": "node scripts/prepare-oos",
    "verify:oos-data-parity": "node scripts/verify-oos-data-parity",
    "verify:december-overlap": "node scripts/verify-december-overlap",
    "diagnose:orb15": "node scripts/diagnose-orb15",
    "reproduce:research": "node scripts/reproduce-research --publish"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
