#!/usr/bin/env node
const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');
const root = path.resolve(__dirname, '..');
const local = path.join(root, '.venv', process.platform === 'win32' ? 'Scripts/python.exe' : 'bin/python');
const python = process.env.PYTHON || (fs.existsSync(local) ? local : 'python3');
const result = spawnSync(python, ['-m', 'scripts.reproduce_research.holdout', ...process.argv.slice(2)], {
  cwd: root, stdio: 'inherit', env: { ...process.env, PYTHONPATH: path.join(root, 'src') + path.delimiter + (process.env.PYTHONPATH || '') },
});
if (result.error) console.error(result.error.message);
process.exit(result.status ?? 1);
