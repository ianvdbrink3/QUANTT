#!/usr/bin/env python3
"""Use .venv/bin/python scripts/verify-prop-challenge [replay|verify|publish]."""
import runpy
import sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
if len(sys.argv)==1:sys.argv.append('verify')
runpy.run_module('scripts.prop_challenge',run_name='__main__')
